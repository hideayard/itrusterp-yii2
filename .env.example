# Salin file ini menjadi .env lalu sesuaikan nilainya.
# File .env dimuat otomatis oleh web/index.php (tidak perlu set env di web server).

# --- Mode aplikasi ---
# 'prod' mematikan YII_DEBUG sehingga pesan error tidak bocor ke klien.
YII_ENV=prod
YII_DEBUG=false

# --- Koneksi database ---
AUREUS_DB_HOST=localhost
AUREUS_DB=aureuserp
AUREUS_DB_USER=aureuserp
AUREUS_DB_PASSWORD=rahasia

# --- Keamanan ---
# Kunci validasi cookie. Buat nilai acak, mis.:
#   php -r "echo bin2hex(random_bytes(32));"
AUREUS_COOKIE_VALIDATION_KEY=ganti-dengan-kunci-acak

# Origin yang diizinkan CORS (pisahkan dengan koma). Hanya perlu bila ada klien yang
# memanggil API langsung dari browser; pemanggilan lewat Astro (server-side) tidak butuh ini.
AUREUS_CORS_ORIGINS=https://itrust-erp.pages.dev

# --- Token akses ---
# Masa berlaku token (hari). Default 90.
AUREUS_TOKEN_TTL_DAYS=90
