# Salin file ini menjadi .env lalu sesuaikan nilainya.
# Semua variabel bersifat opsional — nilai di bawah adalah default aplikasi.

# Koneksi database (default: MySQL lokal)
AUREUS_DB_HOST=localhost
AUREUS_DB=aureuserp
AUREUS_DB_USER=root
AUREUS_DB_PASSWORD=

# Origin yang diizinkan CORS (pisahkan dengan koma)
AUREUS_CORS_ORIGINS=http://localhost:4321

# Masa berlaku token akses (hari). Default 90.
AUREUS_TOKEN_TTL_DAYS=90

# Mode debug Yii (true saat pengembangan, false di produksi)
# YII_DEBUG=true
