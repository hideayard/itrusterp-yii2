# Salin file ini menjadi .env lalu sesuaikan nilainya.
# File .env dimuat otomatis oleh web/index.php (tidak perlu set env di web server).

# --- Mode aplikasi ---
# 'prod' mematikan YII_DEBUG sehingga pesan error tidak bocor ke klien.
YII_ENV=prod
YII_DEBUG=false

# --- Kredensial DB (dipakai docker-compose.with-db.yml & langkah membuat DB) ---
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=erp
MYSQL_USER=itrust
MYSQL_PASSWORD=itrust_password

# --- Koneksi database aplikasi ---
# Default: memakai container MySQL yang sudah ada (publish 127.0.0.1:3307).
# Kalau memakai docker-compose.with-db.yml: host = `db`, port = 3306.
AUREUS_DB_HOST=host.docker.internal
AUREUS_DB_PORT=3307
AUREUS_DB=erp
AUREUS_DB_USER=itrust
AUREUS_DB_PASSWORD=itrust_password

# --- Keamanan ---
# Kunci validasi cookie. Buat nilai acak, mis.:
#   php -r "echo bin2hex(random_bytes(32));"
AUREUS_COOKIE_VALIDATION_KEY=ganti-dengan-kunci-acak

# Origin yang diizinkan CORS (pisahkan dengan koma). Hanya perlu bila ada klien yang
# memanggil API langsung dari browser; pemanggilan lewat Astro (server-side) tidak butuh ini.
AUREUS_CORS_ORIGINS=https://itrust-erp.pages.dev,https://erp.rimondaglobaldigital.com,http://localhost:4321

# --- Token akses ---
# Masa berlaku token (hari). Default 90.
AUREUS_TOKEN_TTL_DAYS=90
