# ---------------------------------------------------------------------------
# iTrustERP API — aturan Apache minimal untuk folder web/ (document root)
#
# Sengaja HANYA memakai direktif mod_rewrite: pada shared hosting dengan
# `AllowOverride` terbatas, direktif seperti `Options`, `DirectoryIndex`, atau
# `<FilesMatch>+Require` memicu "500 Internal Server Error".
# ---------------------------------------------------------------------------

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1) WAJIB: teruskan header Authorization ke PHP.
    #    Di hosting dengan PHP sebagai CGI/FastCGI (umum di cPanel), Apache
    #    membuang header `Authorization: Bearer ...` sehingga semua request
    #    ber-token dijawab 401 Unauthorized.
    RewriteCond %{HTTP:Authorization} .
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # 2) Pretty URL Yii2: request yang bukan berkas/folder nyata → index.php
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule . index.php [L]
</IfModule>

# ---------------------------------------------------------------------------
# Opsional — aktifkan HANYA bila hosting mengizinkan (kalau tidak: 500).
# ---------------------------------------------------------------------------
# <IfModule mod_autoindex.c>
#     Options -Indexes
# </IfModule>
# <IfModule mod_negotiation.c>
#     Options -MultiViews
# </IfModule>
# DirectoryIndex index.php
#
# Perlindungan berkas sensitif (taruh .htaccess ini di DOCUMENT ROOT juga bila
# document root terpaksa bukan folder web/):
# <IfModule mod_authz_core.c>
#     <FilesMatch "^\.|\.(env|sql|log|md|lock|yml|yaml|sh|ps1)$">
#         Require all denied
#     </FilesMatch>
# </IfModule>
#
# Paksa HTTPS (pilih salah satu):
# <IfModule mod_rewrite.c>
#     RewriteCond %{HTTPS} off
#     RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
# </IfModule>
# ...di belakang Cloudflare, pakai:
# <IfModule mod_rewrite.c>
#     RewriteCond %{HTTP:X-Forwarded-Proto} !https
#     RewriteCond %{HTTPS} off
#     RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
# </IfModule>

# ---------------------------------------------------------------------------
# Catatan:
# - JANGAN pakai `php_flag`/`php_value`: pada PHP-FPM/CGI memicu 500.
# - Bila API dipasang di SUBFOLDER, tambahkan `RewriteBase /nama-subfolder/`.
# - `web/index.php` dan `web/robots.txt` balas 500 = ada direktif di atas yang
#   tidak diizinkan hosting → gunakan versi minimal (tanpa blok opsional).
# ---------------------------------------------------------------------------
