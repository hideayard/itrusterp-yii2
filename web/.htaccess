<IfModule mod_rewrite.c>
    RewriteEngine On

    # -----------------------------------------------------------------------
    # 1) WAJIB: teruskan header Authorization ke PHP.
    #    Hosting dengan PHP CGI/suPHP membuang header `Authorization: Bearer ...`
    #    sehingga semua request ber-token dijawab 401.
    # -----------------------------------------------------------------------
    RewriteCond %{HTTP:Authorization} .
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # -----------------------------------------------------------------------
    # 2) Tolak-cepat pola pemindai bot: dijawab Apache (murah) TANPA membangkitkan
    #    proses PHP. Ini yang mencegah CPU/proses 100% saat akun dipindai terus.
    # -----------------------------------------------------------------------
    RewriteRule ^(wp-|wordpress|xmlrpc\.php|phpinfo\.php|php\.ini|php\.cgi|cgi-bin|admin\.php|wp-content|wp-includes|\.env) - [R=404,L]
    RewriteRule \.(php\.[0-9]+|sql|bak|old|swp|git)$ - [R=404,L]

    # -----------------------------------------------------------------------
    # 3) Pretty URL Yii2: request bukan berkas/folder nyata → index.php
    # -----------------------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule . index.php [L]
</IfModule>

# ---------------------------------------------------------------------------
# Opsional (hanya bila document root = folder web/, mis. di hosting):
# batasi PHP hanya untuk endpoint API — path lain 404 dari Apache.
# ---------------------------------------------------------------------------
# <IfModule mod_rewrite.c>
#     RewriteCond %{REQUEST_URI} ^/admin/api/v1(/|$)
#     RewriteCond %{REQUEST_FILENAME} !-f
#     RewriteRule . index.php [L]
#     RewriteCond %{REQUEST_FILENAME} !-f
#     RewriteCond %{REQUEST_FILENAME} !-d
#     RewriteRule ^ - [R=404,L]
# </IfModule>

# ---------------------------------------------------------------------------
# Opsional — mode pemeliharaan sementara (saat akun kehabisan resource):
# hanya IP ini yang boleh mengakses, sisanya 503.
# ---------------------------------------------------------------------------
# <IfModule mod_rewrite.c>
#     RewriteCond %{REMOTE_ADDR} !^103\.153\.62\.30$
#     RewriteRule ^ - [R=503,L]
# </IfModule>
