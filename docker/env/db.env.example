# =============================================================================
#  CONTOH env container MySQL
#  Dipakai oleh docker/mysql/docker-compose.yml (menjalankan MySQL sendiri).
#
#  Cara pakai:
#      cp docker/env/db.env.example docker/env/db.env
#  lalu EDIT nilai yang ditandai  <-- EDIT
#
#  Password root dipakai saat volume DB dibuat pertama kali dan saat menjalankan
#  perintah `mysql` di dalam container.
# =============================================================================

MYSQL_ROOT_PASSWORD=root_password                  # <-- EDIT
MYSQL_DATABASE=erp                                 # <-- EDIT
MYSQL_USER=itrust                                  # <-- EDIT
MYSQL_PASSWORD=itrust_password                     # <-- EDIT

# Penanda versi mayor (informasional; tidak mengubah perilaku image)
MYSQL_MAJOR=8.0

TZ=Asia/Jakarta
