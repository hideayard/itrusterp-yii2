# Salin menjadi docker/env/api.env lalu sesuaikan nilainya.
#   cp docker/env/api.env.example docker/env/api.env
# Berkas .env asli TIDAK ikut ter-commit (.gitignore) — contoh ini yang ikut.

# --- Mode aplikasi ---
YII_ENV=prod
YII_DEBUG=false

# --- Database ---
# Container MySQL yang sudah ada (publish 127.0.0.1:3307):
AUREUS_DB_HOST=host.docker.internal
AUREUS_DB_PORT=3307
# Kalau pakai docker-compose.with-db.yml, nilai host/port ditimpa jadi db:3306.
AUREUS_DB=erp
AUREUS_DB_USER=itrust
AUREUS_DB_PASSWORD=itrust_password

# --- Keamanan ---
# php -r "echo bin2hex(random_bytes(32));"
AUREUS_COOKIE_VALIDATION_KEY=ganti-dengan-64-karakter-acak

# --- CORS (boleh beberapa URL; `*` = semua origin) ---
AUREUS_CORS_ORIGINS=https://itrust-erp.pages.dev,https://erp.rimondaglobaldigital.com,http://localhost:4321

# --- Token akses ---
AUREUS_TOKEN_TTL_DAYS=90

# --- Zona waktu container ---
TZ=Asia/Jakarta
