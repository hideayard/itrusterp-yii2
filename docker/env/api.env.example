# =============================================================================
#  CONTOH env container API (iTrustERP / Yii2)
#
#  Cara pakai:
#      cp docker/env/api.env.example docker/env/api.env
#  lalu EDIT nilai yang ditandai  <-- EDIT  di bawah.
#
#  Berkas hasil salinan (docker/env/api.env) TIDAK ikut ter-commit.
#  Dipakai oleh docker-compose.yml lewat:  api: env_file: [./docker/env/api.env]
# =============================================================================

# --- Mode aplikasi ---
YII_ENV=prod
YII_DEBUG=false

# --- Database ---
# Memakai container MySQL yang SUDAH ADA (publish 127.0.0.1:3307).
# Dari dalam container, "localhost" = container itu sendiri → pakai host.docker.internal
AUREUS_DB_HOST=host.docker.internal
AUREUS_DB_PORT=3307
AUREUS_DB=erp                                      # <-- EDIT nama database
AUREUS_DB_USER=itrust                              # <-- EDIT user database
AUREUS_DB_PASSWORD=itrust_password                 # <-- EDIT password database
# Catatan: bila memakai docker-compose.with-db.yml, host/port di atas ditimpa
# oleh blok `environment:` di compose (host=db, port=3306).

# --- Keamanan ---
# Wajib diganti. Buat nilai baru dengan:
#   php -r "echo bin2hex(random_bytes(32));"
AUREUS_COOKIE_VALIDATION_KEY=ganti-dengan-64-karakter-acak   # <-- EDIT

# --- CORS ---
# Hanya perlu bila ada klien memanggil API langsung dari browser.
# Boleh beberapa URL (pisah koma/spasi). `*` = semua origin.
AUREUS_CORS_ORIGINS=https://itrust-erp.pages.dev,https://erp.rimondaglobaldigital.com,http://localhost:4321   # <-- EDIT

# --- Token akses ---
AUREUS_TOKEN_TTL_DAYS=90

# --- Zona waktu container ---
TZ=Asia/Jakarta
